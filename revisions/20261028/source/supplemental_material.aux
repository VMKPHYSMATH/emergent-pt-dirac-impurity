\@writefile{lof}{\contentsline {figure}{\numberline {S2}{\ignorespaces \textbf  {Causal Smith-delay validation and adverse controls.} Panel (a) tracks the analytic pole pair to the exact core EP at $\beta _0=0.50$. Panel (b) shows the two pole half-widths: they remain positive throughout the retained window and split only on the relative-broken side. Panel (c) compares the largest proper-delay peak with a Hermitian control matched by total rate and with an off-EP kernel of the same total rate ($D=0.05$); the latter exceeds the EP peak because one of its poles decays at only $0.0334$. Panel (d) multiplies the largest proper delay by the slowest pole half-width $\gamma _{\rm  slow}=\min _a[-\operatorname  {Im}z_a]$. The separate off-EP control is marked at $\beta _0=0.50$. The passivity floor $\bar  \Gamma -|\Gamma _{\rm  PT}|$ is not used as a pole width. Together with the unitarity and trace-delay checks, these controls establish the proper delay as a causal coalescence and linewidth fingerprint, not a Kondo-scale multiplier. }}{20}{figure.2}\protected@file@percent }
\newlabel{fig:S_smith}{{S2}{20}{\textbf {Causal Smith-delay validation and adverse controls.} Panel (a) tracks the analytic pole pair to the exact core EP at $\beta _0=0.50$. Panel (b) shows the two pole half-widths: they remain positive throughout the retained window and split only on the relative-broken side. Panel (c) compares the largest proper-delay peak with a Hermitian control matched by total rate and with an off-EP kernel of the same total rate ($D=0.05$); the latter exceeds the EP peak because one of its poles decays at only $0.0334$. Panel (d) multiplies the largest proper delay by the slowest pole half-width $\gamma _{\rm slow}=\min _a[-\operatorname {Im}z_a]$. The separate off-EP control is marked at $\beta _0=0.50$. The passivity floor $\bar \Gamma -|\Gamma _{\rm PT}|$ is not used as a pole width. Together with the unitarity and trace-delay checks, these controls establish the proper delay as a causal coalescence and linewidth fingerprint, not a Kondo-scale multiplier}{figure.2}{}}
\newlabel{eq:smith_ep_app}{{J6}{20}{}{equation.J.6}{}}
\citation{anderson1970poor}
\@writefile{lof}{\contentsline {figure}{\numberline {S3}{\ignorespaces \textbf  {Causal scattering and spectral-density flow diagnostic.} The fixed-$W$ validation uses the positive impurity spectral matrix built from $G^R$ and $G^A$ as the channel density (App.~\ref {app:matrix_rg}), with $\Gamma _0=0.12$ and unit charge gap. Panel (a) compares the largest causal channel-density eigenvalue at $\beta _0=0.50$ with the matched $\Gamma _{\rm  PT}=0$ control. Panel (b) gives the Wigner--Smith trace; the passive Fisher--Lee matrix is unitary to $1.33\times 10^{-15}$ and $\operatorname  {Tr}Q(0)=4/\Gamma _0=33.3333$ at the EP. Panels (c) and (d) show that the EP-active exchange eigenvalue is initially larger, but its threshold-scale ratio crosses below the control before strong coupling. This supports a bounded early-flow ordering of this diagnostic, not an enhanced thermodynamic Kondo temperature. }}{21}{figure.3}\protected@file@percent }
\newlabel{fig:S_causal_rg}{{S3}{21}{\textbf {Causal scattering and spectral-density flow diagnostic.} The fixed-$W$ validation uses the positive impurity spectral matrix built from $G^R$ and $G^A$ as the channel density (App.~\ref {app:matrix_rg}), with $\Gamma _0=0.12$ and unit charge gap. Panel (a) compares the largest causal channel-density eigenvalue at $\beta _0=0.50$ with the matched $\Gamma _{\rm PT}=0$ control. Panel (b) gives the Wigner--Smith trace; the passive Fisher--Lee matrix is unitary to $1.33\times 10^{-15}$ and $\operatorname {Tr}Q(0)=4/\Gamma _0=33.3333$ at the EP. Panels (c) and (d) show that the EP-active exchange eigenvalue is initially larger, but its threshold-scale ratio crosses below the control before strong coupling. This supports a bounded early-flow ordering of this diagnostic, not an enhanced thermodynamic Kondo temperature}{figure.3}{}}
