\@writefile{lof}{\contentsline {figure}{\numberline {S5}{\ignorespaces \textbf  {Separate occupied path in the continuum KR saddle} ($T=0$). The controls are $\mu =0.012$, $V_O=1.21342201$, $W=0.10$ and $\epsilon _d=0.0151703-U/2$, with fixed reference width $\bar  \Gamma _0=0.0025$. Double occupancy $D_d$, the minority eigenvalue of the impurity density matrix, and $1-\langle n_d\rangle $ decrease along this path. The bath is asymmetric, so the gate prescription does not impose particle--hole symmetry. The EP equations are not imposed: the split poles tabulated in App.~\ref {app:KR_n1} neither establish nor exclude an occupied EP after retuning. The certified filling-one EP is shown in main Fig.~\ref {M-fig:KR_n1}.}}{29}{figure.5}\protected@file@percent }
\newlabel{fig:S_KR_occupied}{{S5}{29}{\textbf {Separate occupied path in the continuum KR saddle} ($T=0$). The controls are $\mu =0.012$, $V_O=1.21342201$, $W=0.10$ and $\epsilon _d=0.0151703-U/2$, with fixed reference width $\bar \Gamma _0=0.0025$. Double occupancy $D_d$, the minority eigenvalue of the impurity density matrix, and $1-\langle n_d\rangle $ decrease along this path. The bath is asymmetric, so the gate prescription does not impose particle--hole symmetry. The EP equations are not imposed: the split poles tabulated in App.~\ref {app:KR_n1} neither establish nor exclude an occupied EP after retuning. The certified filling-one EP is shown in main Fig.~\ref {M-fig:KR_n1}}{figure.5}{}}
