\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Full-momentum two-cut nonlinear causal-pole certificate.} The stationary rotating-drive witness uses $\lambda =0.05$ and fixed $W=0.10$, $K=\pi /4$, $\epsilon _O=120$, $\Omega =60$, and the solution in Eq.~(\ref {eq:full_k_ep_solution}). (a) The control ellipse encloses the EP controls; its half-widths are $10^{-4}$ in $\epsilon _d$ and $10^{-2}$ in $V_O$. (b) $\hat  {\cal  D}_{\rm  loc}={\cal  D}_{\rm  loc}/\max _C|{\cal  D}_{\rm  loc}|$ winds once around zero. (c) Actual pole displacements from $z_{\rm  EP}$ (star), with arrows showing increasing control angle. Open circles and filled squares mark the exact initial and final points; the colours exchange at each endpoint. These curves are pole trajectories, not bath branch cuts, and need not individually enclose the star. (d) The continuously unwrapped separation phase advances by $\pi $ in one circuit, giving half-winding $+1/2$. All pole solves pass the separation and residual guards. The certificate concerns the full curved kernel, not its constant-core approximation. }}{7}{figure.2}\protected@file@percent }
\newlabel{fig:full_k_certificate}{{2}{7}{\textbf {Full-momentum two-cut nonlinear causal-pole certificate.} The stationary rotating-drive witness uses $\lambda =0.05$ and fixed $W=0.10$, $K=\pi /4$, $\epsilon _O=120$, $\Omega =60$, and the solution in Eq.~(\ref {eq:full_k_ep_solution}). (a) The control ellipse encloses the EP controls; its half-widths are $10^{-4}$ in $\epsilon _d$ and $10^{-2}$ in $V_O$. (b) $\hat {\cal D}_{\rm loc}={\cal D}_{\rm loc}/\max _C|{\cal D}_{\rm loc}|$ winds once around zero. (c) Actual pole displacements from $z_{\rm EP}$ (star), with arrows showing increasing control angle. Open circles and filled squares mark the exact initial and final points; the colours exchange at each endpoint. These curves are pole trajectories, not bath branch cuts, and need not individually enclose the star. (d) The continuously unwrapped separation phase advances by $\pi $ in one circuit, giving half-winding $+1/2$. All pole solves pass the separation and residual guards. The certificate concerns the full curved kernel, not its constant-core approximation}{figure.2}{}}
