\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {SOC family of full-momentum nonlinear pole EPs.} The double-zero equations are continued in $\lambda $ with $W=0.10$ fixed, while the real impurity gate $\epsilon _d$ and the off-shell auxiliary vertex $V_O$ are retuned. Vertical guides mark $\lambda =0.05$, $0.10$, and $0.15$, where independent local-winding and pole-exchange certificates give winding $+1$, pole permutation $(12)$, and half-winding $+1/2$. The off-shell ratio remains below $0.042$ and the physical rate matrix remains positive. The last panel shows the gap $(\operatorname  {Re}z_{\rm  EP}-\omega _{\rm  th}^{+})/|\operatorname  {Im}z_{\rm  EP}|$ to the driven upper $k=0$ threshold. This is a one-dimensional locus in the enlarged parameter space; neither its threshold endpoint nor a two-dimensional EP region is claimed.}}{8}{figure.3}\protected@file@percent }
\newlabel{fig:full_k_soc_family}{{3}{8}{\textbf {SOC family of full-momentum nonlinear pole EPs.} The double-zero equations are continued in $\lambda $ with $W=0.10$ fixed, while the real impurity gate $\epsilon _d$ and the off-shell auxiliary vertex $V_O$ are retuned. Vertical guides mark $\lambda =0.05$, $0.10$, and $0.15$, where independent local-winding and pole-exchange certificates give winding $+1$, pole permutation $(12)$, and half-winding $+1/2$. The off-shell ratio remains below $0.042$ and the physical rate matrix remains positive. The last panel shows the gap $(\operatorname {Re}z_{\rm EP}-\omega _{\rm th}^{+})/|\operatorname {Im}z_{\rm EP}|$ to the driven upper $k=0$ threshold. This is a one-dimensional locus in the enlarged parameter space; neither its threshold endpoint nor a two-dimensional EP region is claimed}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Retarded real-frequency splitting diagnostic.} Color: $C_s=\operatorname  {Re}(\Sigma _x^2+\Sigma _z^2)/|\Sigma _x^2+\Sigma _z^2|$ at the first scalar reference root $\omega _\ast \in (10^{-4},0.60)$. The matrix is evaluated at $\omega _\ast +i\eta $, $\eta =10^{-10}>0$; upper-rim convergence and positive half-widths are checked separately. Parameters are $U=0$, $W=0.10$, $K=\pi /4$, $\epsilon _O=120$, $\epsilon _d=0.02323413$ and $V_O=1.83318448$. Solid: $C_s=0$ crossover. Dashed: change in the number of open channels at $\omega _\ast $. The circle marks controls of an independently certified complex-pole EP. Neither line defines a region of EPs or exact $\mathcal  {PT}$ symmetry.}}{9}{figure.4}\protected@file@percent }
\newlabel{fig:pt_phase}{{4}{9}{\textbf {Retarded real-frequency splitting diagnostic.} Color: $C_s=\operatorname {Re}(\Sigma _x^2+\Sigma _z^2)/|\Sigma _x^2+\Sigma _z^2|$ at the first scalar reference root $\omega _\ast \in (10^{-4},0.60)$. The matrix is evaluated at $\omega _\ast +i\eta $, $\eta =10^{-10}>0$; upper-rim convergence and positive half-widths are checked separately. Parameters are $U=0$, $W=0.10$, $K=\pi /4$, $\epsilon _O=120$, $\epsilon _d=0.02323413$ and $V_O=1.83318448$. Solid: $C_s=0$ crossover. Dashed: change in the number of open channels at $\omega _\ast $. The circle marks controls of an independently certified complex-pole EP. Neither line defines a region of EPs or exact $\PT $ symmetry}{figure.4}{}}
